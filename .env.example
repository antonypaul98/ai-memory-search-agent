# =============================================================================
# AI Memory Search Agent — Environment Variables
# Copy this file to .env and adjust values for your machine.
# =============================================================================

# --- Application ---
APP_NAME=AI Memory Search Agent
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Storage (Chroma Persistent Client) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=memory_items

# --- Optional item registry (Phase 3+) ---
SQLITE_PATH=./data/videos.db

# --- Embeddings (used in Phase 3+) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking defaults (Phase 3+) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Search defaults (Phase 4+) ---
SEARCH_TOP_K_CHUNKS=30
SEARCH_TOP_K_VIDEOS=10

# --- Distribution & capture ---
PWA_ENABLED=true
AUTH_ENABLED=false
LOCAL_DEMO_MODE=true
JOBS_ENABLED=true
JOB_WORKER_CONCURRENCY=2
PLAYLIST_MAX_VIDEOS=500
YOUTUBE_API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTH_SECRET=change-me-in-production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SEC=60
HIERARCHICAL_RETRIEVAL_ENABLED=true
CAPSULE_TOP_K=8
VIDEO_TOP_K=4
SECTION_TOP_K=6
EVIDENCE_TOP_K=8
RRF_K=60
MMR_LAMBDA=0.7
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SEC=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
EMBEDDING_BATCH_SIZE=32

# --- Optional LLM / Model Router ---
# none | ollama | openai_compatible | router (router integration is opt-in)
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
LLM_API_KEY_ENV=OPENAI_API_KEY
LLM_TIMEOUT_SEC=60

# The model router never stores provider keys. Add only keys/accounts you are allowed to use.
# With OPENROUTER_API_KEY set, `openrouter:openrouter/free` becomes a built-in free route.
OPENROUTER_API_KEY=
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_COOLDOWN_SEC=60
MODEL_ROUTER_PINNED_MODEL=

# Add any additional OpenAI-compatible or Ollama routes as JSON metadata.
# `api_key_env` names an environment variable; never put the actual secret in this JSON.
# Optional daily budgets are local guardrails, not claims about a provider's current limits.
# Example (leave commented until you choose a currently available model):
# GROQ_API_KEY=
# MODEL_ROUTER_CATALOG_JSON='[{"provider_id":"groq","model_id":"YOUR_CURRENT_GROQ_MODEL","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY","free_tier":true,"capabilities":["general","fast","coding","summarization"],"quality_score":0.78,"estimated_latency_ms":150,"daily_request_budget":1000}]'
MODEL_ROUTER_CATALOG_JSON=

# --- Streamlit → FastAPI (Phase 5+) ---
FASTAPI_URL=http://localhost:8000
