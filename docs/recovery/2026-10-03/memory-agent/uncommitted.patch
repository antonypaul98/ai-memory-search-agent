     def strip_transcript(cls, value: str) -> str:
+        # Reject invalid Unicode and control payloads before hashing/routing.
+        try:
+            value.encode("utf-8")
+        except UnicodeEncodeError as exc:
+            raise ValueError("Transcript must be valid Unicode.") from exc
+        if any(ord(char) < 32 and char not in "\n\r\t" for char in value):
