+def _empty_report():
+    return dict(software_contract_passed=False, camera_opened=False,
+                frames_captured=0, required_evidence_produced=False,
+                cleanup_succeeded=False, physical_acceptance="FAIL")
+
+
+def _worker(connection, spec, config):
+    report = _empty_report()
+    devices = []
+    try:
+        validate_config(**config)
+        capture = load_capture_factory(spec)()
+        # Do not certify an injected mock or alternative device as a real camera.
+        if type(capture) is not OpenCVCameraCapture or capture._device_factory is not OpenCVCameraDevice:
+            raise ValueError("physical acceptance requires the standard OpenCV camera capture")
+
+        def tracked_device(**kwargs):
+            device = OpenCVCameraDevice(**kwargs)
+            devices.append(device)
+            original_open, original_read, original_close = device.open, device.read, device.close
+
+            def opened():
+                original_open()
+                report["camera_opened"] = True
+
+            def read():
+                frame = original_read()
+                if frame is not None:
+                    report["frames_captured"] += 1
+                return frame
+
+            def closed():
+                original_close()
+                report["cleanup_succeeded"] = True
+
+            device.open, device.read, device.close = opened, read, closed
+            return device
+
+        capture._device_factory = tracked_device
+        result = run_cli(lambda: capture, **config)
+        report.update(software_contract_passed=result.passed,
+                      required_evidence_produced=result.events_emitted > 0,
+                      frames_processed=result.frames_processed,
+                      events_emitted=result.events_emitted,
+                      stopped_reason=result.stopped_reason,
+                      failure_reasons=result.failure_reasons())
+        if (result.passed and result.stopped_reason == "frame_limit"
+                and report["camera_opened"] and report["cleanup_succeeded"]
+                and report["required_evidence_produced"] and platform.system() == "Darwin"):
+            report["physical_acceptance"] = "PASS"
+    except Exception as exc:
+        # Avoid exposing credentials, images, or arbitrary detector exception text.
+        report["error_type"] = type(exc).__name__
+    finally:
+        for device in devices:
+            try:
+                device.close()
+            except Exception:
+                report["cleanup_succeeded"] = False
+                report["physical_acceptance"] = "FAIL"
+        connection.send(report)
+        connection.close()
+
+
+def run_bounded(spec, config, *, context=None):
+    """Timeout includes factory loading, camera I/O and inference; no stuck threads."""
+    validate_config(**config)
+    context = context or multiprocessing.get_context("spawn")
+    reader, writer = context.Pipe(duplex=False)
+    process = context.Process(target=_worker, args=(writer, spec, config))
+    try:
+        process.start()
+        writer.close()
+        if reader.poll(config["max_duration_seconds"]):
+            try:
+                result = reader.recv()
+            except EOFError:
+                result = {**_empty_report(), "error_type": "WorkerExited"}
+        else:
+            result = {**_empty_report(), "error_type": "Timeout", "cleanup_succeeded": None}
+        process.join(timeout=1)
+        if process.is_alive():
+            process.terminate()
+            process.join(timeout=1)
+            if process.is_alive():
+                process.kill()
+                process.join(timeout=1)
+            result["physical_acceptance"] = "FAIL"
+            result["worker_forced_exit"] = True
+        return result
+    finally:
+        if process.pid is not None and process.is_alive():
+            process.kill()
+            process.join(timeout=1)
+        reader.close()
+        writer.close()
+
 
